# Copy this file to .env and fill in your values.

# --- About you ---
OWNER_NAME=Sam
AGENT_NAME=Ava

# --- Claude (https://console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) is the most natural; claude-haiku-5-5 is much cheaper and a bit faster.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your public server address, e.g. the https URL ngrok prints (no trailing slash)
PUBLIC_BASE_URL=
VALIDATE_TWILIO_SIGNATURE=true

# Speech language and voice. India English: en-IN + Polly.Raveena. Hindi: hi-IN + Polly.Aditi
CALL_LANGUAGE=en-US
TTS_VOICE=Polly.Joanna

# --- Where to send call summaries (fill in any you want) ---
# Telegram (free): create a bot with @BotFather, then message it and get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# SMS through your Twilio number (costs a little per message)
NOTIFY_SMS_TO=

# --- Call log dashboard at /calls (leave empty to turn it off) ---
DASHBOARD_PASSWORD=
