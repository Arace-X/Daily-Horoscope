# Copy this file to .env and fill in your values.
# Write each value right after the = sign, with no quotes and no spaces.

# ---------------------------------------------------------------- About you
# Your first name, as the agent should say it ("You've reached Sam's phone")
OWNER_NAME=
AGENT_NAME=Ava

# ---------------------------------------------------------------- The AI brain
# groq   = free (recommended). Get a free key at https://console.groq.com/keys
# ollama = free, runs on your own computer, no account needed (https://ollama.com)
# claude = paid per use, most natural conversations
LLM_PROVIDER=groq
GROQ_API_KEY=

# Optional: use a different model than the default for your provider
# (groq default: openai/gpt-oss-120b, ollama default: llama3.2)
LLM_MODEL=

# Only if LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Phone (Part 2 of the setup)
# From https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Your public server address: the https URL ngrok shows, with no / at the end
PUBLIC_BASE_URL=

# Speech language and voice.
# US English: en-US + Polly.Joanna   UK: en-GB + Polly.Amy
# Indian English: en-IN + Polly.Raveena   Hindi: hi-IN + Polly.Aditi
CALL_LANGUAGE=en-US
TTS_VOICE=Polly.Joanna

# ---------------------------------------------------------------- Call summaries (Part 3)
# Telegram (free): create a bot with @BotFather and paste its token here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (free). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# SMS through your Twilio number (paid accounts only, costs a little per message)
NOTIFY_SMS_TO=

# ---------------------------------------------------------------- Call log page at /calls
# Pick a password to turn it on (leave empty to keep it off)
DASHBOARD_PASSWORD=
